---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import { articleSchema } from '../../lib/seo';
import { fmtDate, waLink } from '../../lib/site';

export async function getStaticPaths() {
  if (!supabase) return [];
  const { data } = await supabase.from('articles').select('*');
  return (data || []).map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
const paragraphs = (article.content || '').split(/\n+/).filter(Boolean);
const date = article.published_at || article.created_at;
---
<Layout
  title={`${article.title} | مدونة سند الكويت`}
  description={article.snippet || (article.content || '').substring(0, 150)}
  type="article"
  image={article.image_url || undefined}
  schema={articleSchema(article)}
  breadcrumbItems={[{ name: 'المدونة', url: '/blog/' }, { name: article.title, url: `/blog/${article.slug}/` }]}
>
  <article class="max-w-3xl mx-auto px-4 py-12 space-y-6">
    <time class="text-xs bg-amber-100 text-amber-800 px-3 py-1 rounded-full font-bold" datetime={date}>{fmtDate(date)}</time>
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight">{article.title}</h1>
    <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm text-slate-700 text-sm leading-loose space-y-4">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="pt-4 flex justify-between items-center border-t border-slate-200">
      <a href="/blog/" class="text-amber-700 font-bold text-xs">← العودة لقائمة المقالات</a>
      <a href={waLink()} target="_blank" rel="noopener noreferrer" class="bg-emerald-600 text-white font-bold px-4 py-2 rounded-lg text-xs">استفسر عبر واتساب</a>
    </div>
  </article>
</Layout>
